<footer id="footer" class="site-footer">
  <div class="page-gutter site-footer__grid">
    <div>
      <a href="{{ routes.root_url }}" class="site-footer__brand brand-lettering">ＹＡＮÈＬＬＥ</a>
      <p class="site-footer__tagline">{{ section.settings.tagline }}</p>
      <div class="site-footer__socials">
        {% if settings.social_email != blank %}
          <a href="mailto:{{ settings.social_email }}" aria-label="Email">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="5" width="18" height="14" rx="1"/><path d="m3 7 9 7 9-7"/></svg>
          </a>
        {% endif %}
        {% if settings.social_instagram != blank %}
          <a href="{{ settings.social_instagram }}" target="_blank" rel="noopener" aria-label="Instagram">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="0.8" fill="currentColor" stroke="none"/></svg>
          </a>
        {% endif %}
        {% if settings.social_facebook != blank %}
          <a href="{{ settings.social_facebook }}" target="_blank" rel="noopener" aria-label="Facebook">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 8h2.5V5H14a4 4 0 0 0-4 4v2H7.5v3H10v7h3v-7h2.4l.6-3H13V9a1 1 0 0 1 1-1Z"/></svg>
          </a>
        {% endif %}
        {% if settings.social_pinterest != blank %}
          <a href="{{ settings.social_pinterest }}" target="_blank" rel="noopener" aria-label="Pinterest">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="9"/><path d="M9.5 15.5 11 8.5h2.2c1.4 0 2.3.8 2.3 2 0 1.4-1 2.3-2.4 2.3H11.7l-.5 2.7"/></svg>
          </a>
        {% endif %}
        {% if settings.social_telegram != blank %}
          <a href="{{ settings.social_telegram }}" target="_blank" rel="noopener" aria-label="Telegram">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 5 3.5 11.5 9 13.5l1.5 5.5L13 15l5 3.5L21 5Z"/><path d="m9 13.5 10-7"/></svg>
          </a>
        {% endif %}
        {% if settings.social_whatsapp != blank %}
          <a href="{{ settings.social_whatsapp }}" target="_blank" rel="noopener" aria-label="WhatsApp">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M7.5 19.5 5 21l.8-3.2A8.5 8.5 0 1 1 12 20.5a8.4 8.4 0 0 1-4.5-1Z"/></svg>
          </a>
        {% endif %}
      </div>
      {% if settings.social_email != blank %}
        <a class="site-footer__email" href="mailto:{{ settings.social_email }}">{{ settings.social_email }}</a>
      {% endif %}
    </div>

    <div class="site-footer__cols">
      <div>
        <p class="site-footer__label">{{ 'general.footer.explore' | t }}</p>
        <a href="{{ routes.all_products_collection_url }}">{{ 'general.nav.shop' | t }}</a>
        <a href="{{ routes.collections_url }}">{{ 'general.nav.collections' | t }}</a>
        <a href="/pages/lookbook">{{ 'general.nav.lookbook' | t }}</a>
        <a href="/pages/about">{{ 'general.nav.about' | t }}</a>
      </div>
      <div>
        <p class="site-footer__label">{{ 'general.footer.service' | t }}</p>
        <a href="/pages/contact">{{ 'general.nav.contact' | t }}</a>
        <a href="/pages/shipping">{{ 'general.nav.shipping' | t }}</a>
        <a href="/pages/wishlist">{{ 'general.nav.wishlist' | t }}</a>
        <a href="{{ routes.cart_url }}">{{ 'general.nav.cart' | t }}</a>
      </div>
      <div class="col-span-2">
        <p class="site-footer__label">{{ 'general.footer.policies' | t }}</p>
        <a href="/pages/terms">{{ 'general.footer.terms' | t }}</a>
        <a href="/pages/privacy">{{ 'general.footer.privacy' | t }}</a>
        <a href="/pages/cookies">{{ 'general.footer.cookies' | t }}</a>
      </div>
    </div>

    <div class="site-footer__newsletter">
      <h2 class="font-heading">{{ 'general.newsletter.title' | t }}</h2>
      <p>{{ 'general.newsletter.subtitle' | t }}</p>
      {% form 'customer', class: 'site-footer__form' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <input
          type="email"
          name="contact[email]"
          required
          placeholder="{{ 'general.newsletter.placeholder' | t }}"
          aria-label="Email"
        >
        <button type="submit">{{ 'general.newsletter.submit' | t }}</button>
      {% endform %}
    </div>
  </div>

  <div class="page-gutter site-footer__bottom">
    <p>&copy; {{ 'now' | date: '%Y' }} ＹＡＮÈＬＬＥ. {{ 'general.footer.rights' | t }}</p>
    <div class="site-footer__bottom-links">
      <a href="/pages/terms">{{ 'general.footer.terms' | t }}</a>
      <a href="/pages/privacy">{{ 'general.footer.privacy' | t }}</a>
      <a href="/pages/cookies">{{ 'general.footer.cookies' | t }}</a>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "textarea",
      "id": "tagline",
      "label": "Tagline",
      "default": "Quiet forms, honest materials, considered proportions."
    }
  ]
}
{% endschema %}
