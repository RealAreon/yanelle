<section class="section page-gutter bg-beige-deep">
  <div class="fade-in">
    <div style="max-width:42rem;margin-bottom:3rem;">
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      <h2 class="section-title font-heading">{{ section.settings.title }}</h2>
      <p class="text-muted" style="margin-top:1rem;font-size:0.875rem;line-height:1.75;">{{ section.settings.subtitle }}</p>
    </div>
    <div class="journal-grid">
      {% for block in section.blocks %}
        <article class="journal-card" {{ block.shopify_attributes }}>
          <div class="journal-card__media">
            {% if block.settings.image != blank %}
              {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy' }}
            {% elsif block.settings.image_url != blank %}
              <img src="{{ block.settings.image_url }}" alt="" loading="lazy" width="900" height="1125">
            {% else %}
              <img src="https://images.unsplash.com/photo-1558171813-4c088753af8f?auto=format&fit=crop&w=900&q=80" alt="" loading="lazy" width="900" height="1125">
            {% endif %}
          </div>
          <p class="journal-card__cat">{{ block.settings.category }}</p>
          <h3 class="font-heading">{{ block.settings.title }}</h3>
          <p>{{ block.settings.excerpt }}</p>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Fashion journal",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Журнал моди" },
    { "type": "text", "id": "title", "label": "Title", "default": "Нотатки про стиль" },
    { "type": "textarea", "id": "subtitle", "label": "Subtitle", "default": "Тканини, пропорції та спокійні ритуали одягання — редакційні нотатки дому ＹＡＮÈＬＬＥ." }
  ],
  "blocks": [
    {
      "type": "post",
      "name": "Post",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "image_url", "label": "Image URL (fallback)" },
        { "type": "text", "id": "category", "label": "Category", "default": "Style" },
        { "type": "text", "id": "title", "label": "Title", "default": "Quiet layers" },
        { "type": "textarea", "id": "excerpt", "label": "Excerpt", "default": "Як зібрати капсулу без шуму." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Fashion journal",
      "blocks": [
        { "type": "post", "settings": { "category": "Fabric", "title": "Дотик матеріалу", "excerpt": "Чому фактура важливіша за тренд." } },
        { "type": "post", "settings": { "category": "Form", "title": "Чисті лінії", "excerpt": "Пропорції, що тримають силует." } },
        { "type": "post", "settings": { "category": "Ritual", "title": "Ранок без метушні", "excerpt": "Спокійний ритуал одягання." } }
      ]
    }
  ]
}
{% endschema %}
