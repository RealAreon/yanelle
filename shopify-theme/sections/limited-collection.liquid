<section class="section page-gutter bg-mist">
  <div class="fade-in" style="max-width:80rem;margin:0 auto;">
    <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    <h2 class="section-title--xl font-heading">{{ section.settings.title }}</h2>
    <div class="product-grid product-grid--3" style="margin-top:2.5rem;">
      {% assign collection = section.settings.collection | default: collections[settings.limited_collection] %}
      {% for product in collection.products limit: section.settings.limit %}
        {% render 'product-card', product: product %}
      {% else %}
        {% for i in (1..3) %}
          <article class="product-card">
            <div class="product-card__media"></div>
            <div class="product-card__meta"><p class="product-card__title">{{ 'products.product.placeholder' | t }}</p></div>
          </article>
        {% endfor %}
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Limited edition",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Atelier edition" },
    { "type": "text", "id": "title", "label": "Title", "default": "Обмежена серія" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "min": 2, "max": 6, "step": 1, "default": 3, "label": "Products" }
  ],
  "presets": [{ "name": "Limited edition" }]
}
{% endschema %}
