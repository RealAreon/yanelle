<section class="page-gutter" style="padding-bottom:5rem;">
  <div class="page-header fade-in">
    <h1 class="font-heading">{{ 'collections.general.list_title' | t }}</h1>
  </div>
  <div class="collection-banners fade-in">
    {% for collection in collections %}
      {% unless collection.handle == 'all' %}
        <a class="collection-banner" href="{{ collection.url }}">
          {% if collection.featured_image %}
            {{ collection.featured_image | image_url: width: 1200 | image_tag: loading: 'lazy' }}
          {% else %}
            <div style="width:100%;height:100%;background:var(--beige-deep);"></div>
          {% endif %}
          <div class="collection-banner__shade"></div>
          <div class="collection-banner__text">
            <h3 class="font-heading">{{ collection.title }}</h3>
            <span class="collection-banner__cta">{{ 'collections.general.view' | t }}</span>
          </div>
        </a>
      {% endunless %}
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Collections list"
}
{% endschema %}
