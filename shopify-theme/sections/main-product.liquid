<section class="page-gutter product-page">
  <div class="product-gallery fade-in">
    <div class="product-gallery__main">
      {% if product.selected_or_first_available_variant.featured_media %}
        <img
          data-gallery-main
          src="{{ product.selected_or_first_available_variant.featured_media | image_url: width: 1400 }}"
          alt="{{ product.title | escape }}"
          width="1400"
          height="1867"
        >
      {% elsif product.featured_media %}
        <img
          data-gallery-main
          src="{{ product.featured_media | image_url: width: 1400 }}"
          alt="{{ product.title | escape }}"
          width="1400"
          height="1867"
        >
      {% endif %}
    </div>
    {% if product.media.size > 1 %}
      <div class="product-gallery__thumbs">
        {% for media in product.media limit: 8 %}
          <button
            type="button"
            class="{% if forloop.first %}is-active{% endif %}"
            data-gallery-thumb="{{ media | image_url: width: 1400 }}"
          >
            <img src="{{ media | image_url: width: 300 }}" alt="" loading="lazy" width="300" height="400">
          </button>
        {% endfor %}
      </div>
    {% endif %}
  </div>

  <div class="product-info fade-in" data-delay="1">
    <h1 class="font-heading">{{ product.title }}</h1>
    <div class="price">{% render 'price', product: product %}</div>
    {% if product.description != blank %}
      <div class="description">{{ product.description }}</div>
    {% endif %}

    {% assign type_lc = product.type | downcase %}
    {% if type_lc contains 'dress' or type_lc contains 'clothing' or type_lc contains 'одяг' %}
      <details class="size-guide">
        <summary>{{ 'products.product.size_guide' | t }}</summary>
        <table>
          <thead>
            <tr>
              <th scope="col">{{ 'products.product.size' | t }}</th>
              <th scope="col">Груди (см)</th>
              <th scope="col">Талія (см)</th>
              <th scope="col">Стегна (см)</th>
            </tr>
          </thead>
          <tbody>
            <tr><th scope="row">XS</th><td>80–84</td><td>60–64</td><td>86–90</td></tr>
            <tr><th scope="row">S</th><td>84–88</td><td>64–68</td><td>90–94</td></tr>
            <tr><th scope="row">M</th><td>88–92</td><td>68–72</td><td>94–98</td></tr>
            <tr><th scope="row">L</th><td>92–96</td><td>72–76</td><td>98–102</td></tr>
          </tbody>
        </table>
      </details>
    {% endif %}

    {% form 'product', product, data-product-form: true %}
      <div class="variant-picker">
        {% if product.has_only_default_variant %}
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        {% else %}
          <div>
            <label for="VariantSelect">{{ 'products.product.variant' | t }}</label>
            <select id="VariantSelect" name="id" data-variant-select>
              {% for variant in product.variants %}
                <option
                  value="{{ variant.id }}"
                  {% if variant == product.selected_or_first_available_variant %}selected{% endif %}
                  {% unless variant.available %}disabled{% endunless %}
                >
                  {{ variant.title }} — {{ variant.price | money }}
                </option>
              {% endfor %}
            </select>
          </div>
        {% endif %}
        <div>
          <label for="Quantity">{{ 'products.product.quantity' | t }}</label>
          <select id="Quantity" name="quantity">
            {% for i in (1..10) %}
              <option value="{{ i }}">{{ i }}</option>
            {% endfor %}
          </select>
        </div>
      </div>
      <div class="product-form__actions">
        <button type="submit" class="btn btn--full btn--lg" {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}>
          {% if product.selected_or_first_available_variant.available %}
            {{ 'products.product.add_to_cart' | t }}
          {% else %}
            {{ 'products.product.sold_out' | t }}
          {% endif %}
        </button>
        <button
          type="button"
          class="btn btn--ghost btn--full"
          data-wishlist-toggle="{{ product.handle }}"
        >
          {{ 'products.product.wishlist' | t }}
        </button>
      </div>
    {% endform %}
  </div>
</section>

{% assign related_shown = 0 %}
{% assign related_collection = collections.all %}
{% if related_collection == blank %}
  {% assign related_collection = collections['all'] %}
{% endif %}
{% if related_collection != blank %}
  {% for p in related_collection.products %}
    {% if p.type == product.type and p.id != product.id %}
      {% assign related_shown = related_shown | plus: 1 %}
    {% endif %}
  {% endfor %}
{% endif %}

{% if related_shown > 0 %}
  {% assign related_shown = 0 %}
  <section class="product-related page-gutter">
    <h2 class="product-related__title font-heading">{{ 'products.product.related' | t }}</h2>
    <div class="product-grid fade-in">
      {% for p in related_collection.products %}
        {% if p.type == product.type and p.id != product.id and related_shown < 4 %}
          {% render 'product-card', product: p %}
          {% assign related_shown = related_shown | plus: 1 %}
        {% endif %}
      {% endfor %}
    </div>
  </section>
{% endif %}

{% schema %}
{
  "name": "Product"
}
{% endschema %}
