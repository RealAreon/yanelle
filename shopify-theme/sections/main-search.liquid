<section class="page-gutter" style="padding-bottom:5rem;">
  <div class="page-header fade-in">
    <h1 class="font-heading">{{ 'general.search.title' | t }}</h1>
  </div>
  <form action="{{ routes.search_url }}" method="get" class="fade-in" style="margin-bottom:2.5rem;display:flex;gap:0.5rem;max-width:32rem;">
    <input
      type="search"
      name="q"
      value="{{ search.terms | escape }}"
      placeholder="{{ 'general.search.placeholder' | t }}"
      style="flex:1;height:2.75rem;border:1px solid var(--border);background:transparent;padding:0 0.85rem;"
    >
    <button type="submit" class="btn">{{ 'general.search.submit' | t }}</button>
  </form>

  <div class="product-grid fade-in">
    {% if search.performed %}
      {% for item in search.results %}
        {% if item.object_type == 'product' %}
          {% render 'product-card', product: item %}
        {% endif %}
      {% else %}
        <p class="text-muted">{{ 'general.search.no_results' | t }}</p>
      {% endfor %}
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Search"
}
{% endschema %}
