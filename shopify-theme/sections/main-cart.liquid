<section class="page-gutter" style="padding-bottom:5rem;">
  <div class="page-header fade-in">
    <h1 class="font-heading">{{ 'cart.general.title' | t }}</h1>
  </div>

  {% if cart.item_count == 0 %}
    <div class="fade-in" style="text-align:center;padding:4rem 0;">
      <p class="font-heading" style="font-size:2rem;">{{ 'cart.general.empty' | t }}</p>
      <a class="btn" style="margin-top:2rem;" href="{{ routes.all_products_collection_url }}">{{ 'general.nav.shop' | t }}</a>
    </div>
  {% else %}
    <div class="cart-page fade-in">
      <div>
        {% for item in cart.items %}
          <div class="cart-line" style="border-bottom:1px solid var(--border);">
            <div class="cart-line__media">
              <a href="{{ item.url }}">
                <img src="{{ item.image | image_url: width: 300 }}" alt="{{ item.title | escape }}" width="300" height="400">
              </a>
            </div>
            <div style="flex:1;">
              <a class="cart-line__title" href="{{ item.url }}">{{ item.product.title }}</a>
              <p class="cart-line__meta">{{ item.variant.title }}</p>
              <p class="cart-line__price">{{ item.final_line_price | money }}</p>
              <div style="margin-top:1rem;display:flex;gap:0.75rem;align-items:center;">
                {% comment %} Quantity update via cart form {% endcomment %}
                <span>{{ 'products.product.quantity' | t }}: {{ item.quantity }}</span>
                <a class="link-underline" href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity=0">{{ 'cart.general.remove' | t }}</a>
              </div>
            </div>
          </div>
        {% endfor %}
      </div>
      <aside class="cart-summary">
        <div style="display:flex;justify-content:space-between;font-size:0.875rem;">
          <span>{{ 'cart.general.subtotal' | t }}</span>
          <strong>{{ cart.total_price | money }}</strong>
        </div>
        <p class="text-muted" style="margin-top:1rem;border-top:1px solid var(--border);padding-top:1rem;font-size:12px;">
          {{ 'cart.general.free_shipping' | t }}
        </p>
        <form action="{{ routes.cart_url }}" method="post">
          <button type="submit" name="checkout" class="btn btn--full btn--lg" style="margin-top:1.5rem;">
            {{ 'cart.general.checkout' | t }}
          </button>
        </form>
      </aside>
    </div>
  {% endif %}
</section>

{% schema %}
{
  "name": "Cart"
}
{% endschema %}
