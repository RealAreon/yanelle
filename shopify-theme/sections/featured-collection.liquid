<section class="section page-gutter bg-muted">
  <div class="fade-in">
    <div class="section-heading-row" style="margin-bottom:2.5rem;">
      <h2 class="font-heading section-title" style="margin:0;">{{ section.settings.title }}</h2>
      <a class="link-underline" href="{{ section.settings.collection.url | default: routes.all_products_collection_url }}">{{ section.settings.link_label }}</a>
    </div>
    <div class="product-grid">
      {% if section.settings.collection != blank %}
        {% assign collection = section.settings.collection %}
      {% elsif collections[settings.featured_collection] != blank %}
        {% assign collection = collections[settings.featured_collection] %}
      {% else %}
        {% assign collection = collections.all %}
      {% endif %}
      {% for product in collection.products limit: section.settings.limit %}
        {% render 'product-card', product: product %}
      {% else %}
        {% for i in (1..4) %}
          <article class="product-card">
            <div class="product-card__media" style="background:var(--beige-deep);"></div>
            <div class="product-card__meta">
              <div>
                <p class="product-card__title">{{ 'products.product.placeholder' | t }}</p>
                <p class="product-card__type">Sample</p>
              </div>
            </div>
          </article>
        {% endfor %}
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured products",
  "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "Обране" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Переглянути колекцію" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "label": "Products", "min": 2, "max": 8, "step": 1, "default": 4 }
  ],
  "presets": [{ "name": "Featured products" }]
}
{% endschema %}
