<section class="page-gutter" style="padding-bottom:5rem;" data-catalog>
  <div class="page-header fade-in">
    <p class="eyebrow">The complete edit</p>
    <h1 class="font-heading">{{ collection.title }}</h1>
    {% if collection.description != blank %}
      <p class="text-muted" style="margin-top:1rem;max-width:36rem;font-size:0.875rem;line-height:1.75;">{{ collection.description }}</p>
    {% endif %}
  </div>

  <div class="catalog-layout fade-in">
    <aside class="catalog-filters">
      <label class="catalog-field">
        <span>{{ 'collections.general.search' | t }}</span>
        <input type="search" data-catalog-search placeholder="{{ 'general.search.placeholder' | t }}">
      </label>
      <label class="catalog-field">
        <span>{{ 'collections.general.category' | t }}</span>
        <select data-catalog-category>
          <option value="">{{ 'collections.general.all' | t }}</option>
          {% assign types = collection.all_types | default: collection.products | map: 'type' | uniq %}
          {% for type in collection.all_types %}
            <option value="{{ type | escape }}">{{ type }}</option>
          {% endfor %}
          {% comment %} fallback categories from product types on page {% endcomment %}
        </select>
      </label>
      <label class="catalog-field">
        <span>{{ 'collections.general.tag' | t }}</span>
        <select data-catalog-tag>
          <option value="">{{ 'collections.general.all' | t }}</option>
          <option value="new">New</option>
          <option value="sale">Sale</option>
          <option value="limited">Limited</option>
          <option value="featured">Featured</option>
        </select>
      </label>
      <label class="catalog-field">
        <span>{{ 'collections.general.sort' | t }}</span>
        <select data-catalog-sort>
          <option value="newest">{{ 'collections.general.sort_newest' | t }}</option>
          <option value="price-asc">{{ 'collections.general.sort_price_asc' | t }}</option>
          <option value="price-desc">{{ 'collections.general.sort_price_desc' | t }}</option>
        </select>
      </label>
    </aside>

    <div>
      <p class="text-muted" style="margin-bottom:1.25rem;font-size:12px;letter-spacing:0.12em;text-transform:uppercase;" data-catalog-count></p>
      <div class="product-grid" data-catalog-grid>
        {% paginate collection.products by 50 %}
          {% for product in collection.products %}
            <div
              data-catalog-item
              data-title="{{ product.title | downcase | escape }}"
              data-type="{{ product.type | escape }}"
              data-tags="{{ product.tags | join: ',' | downcase }}"
              data-price="{{ product.price }}"
              data-new="{% if product.tags contains 'new' %}1{% else %}0{% endif %}"
            >
              {% render 'product-card', product: product %}
            </div>
          {% else %}
            <p class="text-muted">{{ 'collections.general.empty' | t }}</p>
          {% endfor %}
        {% endpaginate %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collection catalog",
  "settings": []
}
{% endschema %}
