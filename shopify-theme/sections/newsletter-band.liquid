<section class="newsletter-band page-gutter">
  <div class="fade-in">
    <h2 class="section-title font-heading" style="margin:0;">{{ section.settings.title }}</h2>
    <p>{{ section.settings.subtitle }}</p>
    <a href="#footer">{{ section.settings.cta_label }}</a>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter band",
  "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "Листи без зайвого" },
    { "type": "textarea", "id": "subtitle", "label": "Subtitle", "default": "Рідкісні новини про колекції, ательє та тихі запуски." },
    { "type": "text", "id": "cta_label", "label": "CTA", "default": "Підписатися" }
  ],
  "presets": [{ "name": "Newsletter band" }]
}
{% endschema %}
