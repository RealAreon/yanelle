{% if section.settings.collection != blank %}
  {% assign collection = section.settings.collection %}
{% elsif collections[settings.new_collection] != blank %}
  {% assign collection = collections[settings.new_collection] %}
{% else %}
  {% assign collection = collections.all %}
{% endif %}
{% if collection != blank and collection.products_count > 0 %}
<section class="section page-gutter bg-muted">
  <div class="fade-in">
    <div class="section-heading-row" style="margin-bottom:2.5rem;">
      <h2 class="font-heading section-title" style="margin:0;">{{ section.settings.title }}</h2>
      <a class="link-underline" href="{{ collection.url | default: routes.all_products_collection_url }}">{{ section.settings.link_label }}</a>
    </div>
    <div class="product-grid">
      {% for product in collection.products limit: section.settings.limit %}
        {% render 'product-card', product: product %}
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

{% schema %}
{
  "name": "New arrivals",
  "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "Новинки" },
    { "type": "text", "id": "link_label", "label": "Link", "default": "Переглянути колекцію" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "min": 2, "max": 8, "step": 1, "default": 4, "label": "Products" }
  ],
  "presets": [{ "name": "New arrivals" }]
}
{% endschema %}
