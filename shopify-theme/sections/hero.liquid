<section class="hero">
  <div class="hero__media">
    {% if section.settings.image != blank %}
      {{ section.settings.image | image_url: width: 2400 | image_tag: loading: 'eager', widths: '800,1200,1600,2400' }}
    {% else %}
      <img src="https://images.unsplash.com/photo-1490481651871-ab68de25d43d?auto=format&fit=crop&w=2400&q=90" alt="" loading="eager" width="2400" height="1600">
    {% endif %}
  </div>
  <div class="hero__overlay"></div>
  <div class="page-gutter hero__content">
    <div class="fade-in" style="width:100%;max-width:42rem;">
      <p class="hero__brand brand-lettering">ＹＡＮÈＬＬＥ</p>
      <h1 class="hero__title font-heading">{{ section.settings.title }}</h1>
      <p class="hero__subtitle">{{ section.settings.subtitle }}</p>
      <div class="hero__actions">
        {% if section.settings.cta_shop_label != blank %}
          <a class="btn btn--beige" href="{{ section.settings.cta_shop_link | default: routes.all_products_collection_url }}">{{ section.settings.cta_shop_label }}</a>
        {% endif %}
        {% if section.settings.cta_lookbook_label != blank %}
          <a class="btn btn--outline-light" href="{{ section.settings.cta_lookbook_link | default: '/pages/lookbook' }}">{{ section.settings.cta_lookbook_label }}</a>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "text", "id": "title", "label": "Title", "default": "Форми без шуму" },
    { "type": "textarea", "id": "subtitle", "label": "Subtitle", "default": "Одяг і аксесуари з стриманою елегантністю — для тих, хто обирає якість над жестом." },
    { "type": "text", "id": "cta_shop_label", "label": "Primary CTA", "default": "Переглянути колекцію" },
    { "type": "url", "id": "cta_shop_link", "label": "Primary CTA link" },
    { "type": "text", "id": "cta_lookbook_label", "label": "Secondary CTA", "default": "Дивитись lookbook" },
    { "type": "url", "id": "cta_lookbook_link", "label": "Secondary CTA link" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
