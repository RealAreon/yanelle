<aside class="cart-drawer" data-cart-drawer aria-hidden="true">
  <div class="cart-drawer__header" style="display:flex;align-items:flex-start;justify-content:space-between;gap:1rem;">
    <div>
      <h2 class="font-heading">{{ 'cart.general.title' | t }}</h2>
      <p>{{ 'cart.general.free_shipping' | t }}</p>
    </div>
    <button type="button" class="icon-btn" data-cart-close aria-label="{{ 'accessibility.close' | t }}">
      {% render 'icon-close' %}
    </button>
  </div>
  <div class="cart-drawer__body" data-cart-drawer-body></div>
  <div class="cart-drawer__footer" data-cart-drawer-footer hidden>
    <div class="cart-drawer__subtotal">
      <span>{{ 'cart.general.subtotal' | t }}</span>
      <strong data-cart-subtotal></strong>
    </div>
    <a href="{{ routes.cart_url }}" class="btn btn--full btn--lg" style="margin-bottom:0.5rem;letter-spacing:0.06em;font-size:11px;white-space:normal;">
      {{ 'cart.general.view_cart' | t }}
    </a>
    <form action="{{ routes.cart_url }}" method="post">
      <button type="submit" name="checkout" class="btn btn--full btn--lg" style="letter-spacing:0.06em;font-size:11px;white-space:normal;">
        {{ 'cart.general.checkout' | t }}
      </button>
    </form>
  </div>
</aside>
