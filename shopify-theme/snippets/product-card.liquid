{% comment %}
  Renders a product card
  Accepts: product
{% endcomment %}
<article class="product-card group">
  <a href="{{ product.url }}" class="product-card__media">
    {% if product.featured_media %}
      <img
        src="{{ product.featured_media | image_url: width: 900 }}"
        alt="{{ product.featured_media.alt | escape }}"
        loading="lazy"
        width="900"
        height="1200"
      >
    {% endif %}
    <div class="product-card__badges">
      {% if product.tags contains 'new' %}
        <span class="badge">{{ 'products.product.badge_new' | t }}</span>
      {% endif %}
      {% if product.tags contains 'sale' or product.compare_at_price > product.price %}
        <span class="badge">{{ 'products.product.badge_sale' | t }}</span>
      {% endif %}
      {% if product.tags contains 'limited' %}
        <span class="badge">{{ 'products.product.badge_limited' | t }}</span>
      {% endif %}
    </div>
  </a>
  <button
    type="button"
    class="product-card__wish"
    data-wishlist-toggle="{{ product.handle }}"
    aria-label="{{ 'products.product.wishlist' | t }}"
    aria-pressed="false"
  >
    {% render 'icon-heart' %}
  </button>
  <div class="product-card__meta">
    <div>
      <a href="{{ product.url }}" class="product-card__title">{{ product.title }}</a>
      {% if product.type != blank %}
        <p class="product-card__type">{{ product.type }}</p>
      {% endif %}
    </div>
    <div class="product-card__price">
      {% render 'price', product: product %}
    </div>
  </div>
</article>
