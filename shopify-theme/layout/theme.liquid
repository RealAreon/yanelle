<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_header }}">
    <link rel="canonical" href="{{ canonical_url }}">
    <title>
      {{ page_title }}{% if current_tags %} &ndash; {{ current_tags | join: ', ' }}{% endif %}{% if current_page != 1 %} &ndash; {{ 'general.pagination.page' | t: page: current_page }}{% endif %}{% unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless %}
    </title>
    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}
    {{ content_for_header }}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=Montserrat:wght@300;400;500;600&display=swap" rel="stylesheet">
    {{ 'yanelle.css' | asset_url | stylesheet_tag }}
    <script>
      document.documentElement.classList.remove('no-js');
      document.documentElement.classList.add('js');
      window.Yanelle = {
        routes: {
          cart_url: '{{ routes.cart_url }}',
          cart_add_url: '{{ routes.cart_add_url }}',
          cart_change_url: '{{ routes.cart_change_url }}',
          cart_update_url: '{{ routes.cart_update_url }}',
          search_url: '{{ routes.search_url }}'
        },
        strings: {
          cartEmpty: {{ 'cart.general.empty' | t | json }},
          addToCart: {{ 'products.product.add_to_cart' | t | json }}
        },
        moneyFormat: {{ shop.money_format | json }}
      };
    </script>
  </head>
  <body class="yanelle-body">
    <a class="skip-link" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>
    {% section 'header' %}
    <main id="MainContent" class="main-content page-in" role="main">
      {{ content_for_layout }}
    </main>
    {% section 'footer' %}
    {% render 'cart-drawer' %}
    <div class="drawer-overlay" data-drawer-overlay hidden></div>
    {{ 'yanelle.js' | asset_url | script_tag }}
  </body>
</html>
