<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>ＹＡＮÈＬＬＥ</title>
    {{ content_for_header }}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=Montserrat:wght@300;400;500&display=swap" rel="stylesheet">
    {{ 'yanelle.css' | asset_url | stylesheet_tag }}
  </head>
  <body class="yanelle-body">
    <div class="page-gutter" style="min-height:100svh;display:flex;align-items:center;justify-content:center;text-align:center;padding:3rem 1.25rem;">
      <div class="fade-in is-visible" style="max-width:28rem;width:100%;">
        <p class="brand-lettering font-heading" style="font-size:clamp(1.5rem,5vw,2.5rem);letter-spacing:0.28em;">ＹＡＮÈＬＬＥ</p>
        <p class="text-muted" style="margin-top:1.25rem;font-size:0.875rem;line-height:1.7;">Тиха розкіш. Чисті лінії.</p>
        {% form 'storefront_password', class: 'password-form' %}
          <label class="eyebrow" style="display:block;margin-top:2.5rem;" for="Password">Пароль магазину</label>
          <input
            id="Password"
            type="password"
            name="password"
            style="margin-top:0.75rem;width:100%;height:2.75rem;border:1px solid var(--border);background:transparent;padding:0 1rem;text-align:center;"
          >
          <button type="submit" class="btn btn--full" style="margin-top:0.75rem;">Увійти</button>
          {% if form.errors %}
            <p class="text-muted" style="margin-top:0.75rem;color:#b54a3f;">{{ form.errors | join: ', ' }}</p>
          {% endif %}
        {% endform %}
      </div>
    </div>
  </body>
</html>
